                ',[BRAND_GENERIC] ' +
                ',[LEGEND_STATUS] ' +
                ',[FederalDEAClass] ' +
                ',[INSTANCIA]) ' +
                'VALUES  (' +
                IntToStr(response.Product[I].ProductID)  +
