Procedure TGDDS5Routines.DetailProductSTR;
Var
  request: DetailProductRequest;
  response: DetailProduct;
  alc: ProductIdentifierType; //ProductIdentifierType; //FilterType;// ProductIdentifierTypeEnum;// FilterType;// IdentifierChoiceType; //IdentifierChoiceType; //ProductIdentifierType; //FilterIdType;// AlchemyIdentifierType;
  Serv: GSDDServiceSoap;
  Resp, Casa_Farmaceutica, BRAND, Product, Strength, Token1, Token2, Token3: String;
  ProductID: Integer;
begin
  With DM do
  begin
      ProductID := CDSListProductsPRODUCT_ID.Value; // AlchemyProductIdentifierResult(CDSInventarioNDC.Value);
      if ProductID > 0 then
      begin
        alc := ProductIdentifierType.Create;
        alc.IdentifierType := ProductIdentifierEnum.ProductID;
        alc.Identifier := IntToStr(ProductID);
        request := DetailProductRequest.Create;
        request.ProductIdentifier := alc;

        With DetailProductRequest do
        begin
          Serv  :=  GetGSDDServiceSoap(False,'', FrmMain.HTTPRIO2);
          Response := Serv.DetailProduct(DetailProductRequest(request));
        end;
        Casa_Farmaceutica := response.Detail.Marketer;
        if Trim(Casa_Farmaceutica) = '' then Casa_Farmaceutica := 'N/A';
        if response.Detail.BrandGenericStatus = 'Brand' then BRAND := 'T' else BRAND := 'F';

        if (DSInventario.State = dsEdit) or (DSInventario.State = dsInsert) then
        begin
          CDSInventarioCASA_FARMACEUTICA.VAlue := UpperCase(Copy(Casa_Farmaceutica,1, 35));
          CDSInventarioBRAND.Value := Brand;
          CDSInventarioCONTROLADO.Value := UpperCase(response.Detail.LegendStatus);
        end;
      end;

  end;
end;


