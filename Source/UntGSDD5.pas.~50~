                ','+ chr(39) + Copy(ValidateText(response.Product[I].Marketer),1, 60) + chr(39)+
                ',' + chr(39)+  Copy(response.Product[I].ProductNameType, 1, 30)+ chr(39) +
                ',' + chr(39)+ Copy(ValidateText(response.Product[I].BrandGenericStatus), 1, 10)+ chr(39) +
                ','+ chr(39) + Copy(response.Product[I].LegendStatus, 1, 2)+ chr(39) +
                ','+ chr(39) + Copy(response.Product[I].FederalDEAClass, 1, 12)+ chr(39) +
                ','+  IntToStr(1) + ')' ;
                SQLQuery1.ExecSQL();

                CDSListProducts.Close;
                CDSListProducts.CommandText := 'Select * from List_Products where Instancia = ' + IntToStr(1);
                CDSListProducts.Open;
            end;
          end;
        end;
      except
       //
      end;
     if DM.CDSListProducts.RecordCount = 0 then
     begin
       ShowMessage('Product not found');
       //Button3.Enabled := True;
     end;
  end;
end;


