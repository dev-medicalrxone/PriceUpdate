      alc := ProductFilterType.Create;
      alc.ProductNameFilter := Trim(Token)+'%';
      request := ListProductsRequest.Create;
      request.Filter := alc;
    end;
      try
        DM.CDSListProducts.Active := False;
        DM.CDSListProducts.Active := True;
        With ListProductsRequest do
        begin
          Serv  :=  GetGSDDServiceSoap(False,'', FrmMain.HTTPRIO2);
          Response := Serv.ListProducts(ListProductsRequest(request));
          Counter := Length(response.Product);
              for I := 0 to Counter - 1 do
