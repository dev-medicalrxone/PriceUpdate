                SQLQuery1.SQL.Text := 'INSERT INTO [dbo].[LIST_PRODUCTS] ' +
                '([PRODUCT_ID] ' +
                ',[DESCRIPTION] ' +
                ',[CASA_FARMACEUTICA] ' +
