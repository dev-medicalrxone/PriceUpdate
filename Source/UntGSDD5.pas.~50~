function ValidateText(Token: String): String;
Var
  Counter: Integer;
  Str: String;
begin
  Result := '';
  Counter :=1;
  while Counter <= Length(Token) do
  begin
     Str := UpperCase(Copy(Token, Counter, 1));
     if Copy(Token, Counter, 1) = 'Ñ' then Str := 'N';
     if Copy(Token, Counter, 1) = 'ñ' then Str := 'n';
     if Copy(Token, Counter, 1) = 'Á' then Str := 'A';
     if Copy(Token, Counter, 1) = 'á' then Str := 'a';
     if Copy(Token, Counter, 1) = 'É' then Str := 'E';
     if Copy(Token, Counter, 1) = 'é' then Str := 'e';
     if Copy(Token, Counter, 1) = 'Í' then Str := 'I';
     if Copy(Token, Counter, 1) = 'í' then Str := 'i';
     if Copy(Token, Counter, 1) = 'Ó' then Str := 'O';
     if Copy(Token, Counter, 1) = 'ó' then Str := 'o';
     if Copy(Token, Counter, 1) = 'Ú' then Str := 'U';
     if Copy(Token, Counter, 1) = 'ú' then Str := 'u';
     if Copy(Token, Counter, 1) = '.' then Str := '';
     if Copy(Token, Counter, 1) = '"' then Str := '';
     if Copy(Token, Counter, 1) = '>' then Str := '';
     if Copy(Token, Counter, 1) = '<' then Str := '';
     if Copy(Token, Counter, 1) = '&' then Str := '';
     if Copy(Token, Counter, 1) = '`' then Str := '';
     if Copy(Token, Counter, 1) = '}' then Str := '';
     if Copy(Token, Counter, 1) = '{' then Str := '';
     if Copy(Token, Counter, 1) = '~' then Str := '';
     if Copy(Token, Counter, 1) = ')' then Str := '';
     if Copy(Token, Counter, 1) = '(' then Str := '';
     if Copy(Token, Counter, 1) = chr(39) then Str := '';
     if Copy(Token, Counter, 1) = chr(28) then Str := '';
     if Copy(Token, Counter, 1) = '' then Str := ' ';
     Result := Result + Str;
     Str := '';
     Counter := Counter + 1;
  end;
end;

function IsNumber(Token: String):boolean;
var
  i: extended;
begin
  Result := TryStrToFloat(Token,i);
end;

