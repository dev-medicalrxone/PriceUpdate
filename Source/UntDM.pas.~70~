procedure TDM.CDSDoctoresCalcFields(DataSet: TDataSet);
Var
  Date,Univdate,DateAgain:TDateTime;
  MyDate:TDateTime;
  TempTime, TempDate: String;
begin

  if CDSDoctoresAPELLIDO_MATERNO.Value > '' then
    CDSDoctoresNombreCompleto.Value := Trim(CDSDoctoresAPELLIDO_PATERNO.Value) +' '+ Trim(CDSDoctoresAPELLIDO_MATERNO.Value) +', '+ Trim(CDSDoctoresNOMBRE.Value)
  else
    CDSDoctoresNombreCompleto.Value := Trim(CDSDoctoresAPELLIDO_PATERNO.Value) +', '+ Trim(CDSDoctoresNOMBRE.Value);


  Try
    if Trim(CDSDoctoresActiveStartTime.Value) > '' then
    begin
      TempDate := Copy(CDSDoctoresActiveStartTime.Value, 6, 2) + '/' + Copy(CDSDoctoresActiveStartTime.Value, 9, 2)  + '/' +  Copy(CDSDoctoresActiveStartTime.Value, 1, 4);
      TempTime := Copy(CDSDoctoresActiveStartTime.Value, 12, 10);
      MyDate := StrToTime(TempTime);
      Univdate := DateTime2UnivDateTime(MyDate);
      DateAgain := UnivDateTime2LocalDateTime(Univdate);
      CDSDoctoresActiveStartTimeDefine.Value := TempDate + ' - ' + TimeToStr(Univdate);; // DateTimeToStr(Univdate);
    end;
    if Trim(CDSDoctoresActiveEndTime.Value) > '' then
    begin
      TempDate := Copy(CDSDoctoresActiveEndTime.Value, 6, 2) + '/' + Copy(CDSDoctoresActiveEndTime.Value, 9, 2)  + '/' +  Copy(CDSDoctoresActiveEndTime.Value, 1, 4);
      TempTime := Copy(CDSDoctoresActiveEndTime.Value, 12, 10);
      MyDate := StrToTime(TempTime);
      Univdate := DateTime2UnivDateTime(MyDate);
      DateAgain := UnivDateTime2LocalDateTime(Univdate);
      CDSDoctoresActiveEndTimeDefine.Value := TempDate + ' - ' + TimeToStr(Univdate);; // DateTimeToStr(Univdate);
    end;
  Except

  End;

  if Trim(CDSDoctoresESPECIALIDAD.Value) > '' then
  begin
    CDSDoctoresEspecialidad_defined.Value := AMASpecialtyCodeDefine(Trim(CDSDoctoresESPECIALIDAD.Value));
  end;

end;

