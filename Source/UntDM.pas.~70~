procedure TDM.CDSPrescriptionsCalcFields(DataSet: TDataSet);
Var
  TotalDispensado, TotalRecetado: Double;
  Dias: Integer;
  Mensage: String;
  Expirada: Boolean;
begin
{  Try
  if CDSPrescriptionsCANTIDADRECETADA.Value > 0 then
  begin
    if CDSPrescriptionsNUMEROREFILLSAUTORIZADOS.Value > 0 then
      TotalRecetado := (CDSPrescriptionsCANTIDADRECETADA.Value * CDSPrescriptionsNUMEROREFILLSAUTORIZADOS.Value) + CDSPrescriptionsCANTIDADRECETADA.Value
    else
      TotalRecetado := CDSPrescriptionsCANTIDADRECETADA.Value;
    TotalDispensado := TotalRecetado - CDSPrescriptionsCANTIDAD_DISPONIBLE.Value;
    CDSPrescriptionsNO_REFILL.Value := (TotalDispensado / CDSPrescriptionsCANTIDADRECETADA.Value) - 1;
    if CDSPrescriptionsNO_REFILL.Value < 0 then CDSPrescriptionsNO_REFILL.Value := 0;
    Expirada := False;
    if Trim(CDSPrescriptionsCONTROLADO.Value) = 'RX' then
    begin
      if ((CDSPrescriptionsFECHARECETA.AsDateTime + CDSSetupRX_EXPIRATION_DAYS.Value) < Date) then
        Expirada := True;
    end
    else
    begin
       if ((CDSPrescriptionsFECHARECETA.AsDateTime + CDSSetupRX_CONTROLED_EXPIRATION_DAYS.Value) < Date) then
        Expirada := True;
    end;
    if Expirada = True then
      CDSPrescriptionsPROXIMOREFILL.Value := 'Rx Expirada'
    else
    begin
      if TotalRecetado = CDSPrescriptionsCANTIDAD_DISPONIBLE.Value then
        CDSPrescriptionsPROXIMOREFILL.Value := 'N/A'
      else
      begin
        if (CDSPrescriptionsNUMEROREFILLSAUTORIZADOS.Value > 0) and (CDSPrescriptionsFECHAULTIMOREFILL.AsString > '') then
        begin
          if (CDSPrescriptionsFECHAULTIMOREFILL.AsDateTime + CDSPrescriptionsDIASSUPLIDOS.Value < Date) and
          (((CDSPrescriptionsNUMEROREFILLSAUTORIZADOS.Value * CDSPrescriptionsCANTIDADRECETADA.Value) + CDSPrescriptionsCANTIDADRECETADA.Value) <> CDSPrescriptionsCANTIDAD_DISPONIBLE.Value) then
            Mensage := 'LISTA'
          else
           // Mensage := 'EN ' + IntToStr( DaysBetween(date, CDSPrescriptionsFECHAULTIMOREFILL.AsDateTime + CDSPrescriptionsDIASSUPLIDOS.Value)) + ' dias';
          CDSPrescriptionsPROXIMOREFILL.Value := Mensage;
        end
        else
          CDSPrescriptionsPROXIMOREFILL.Value := 'N/A';
        if CDSPrescriptionsCANTIDAD_DISPONIBLE.Value = 0 then CDSPrescriptionsPROXIMOREFILL.Value := 'N/A';
      end;
      //if (((CDSPrescriptionsNUMEROREFILLSAUTORIZADOS.Value * CDSPrescriptionsCANTIDADRECETADA.Value) + CDSPrescriptionsCANTIDADRECETADA.Value) = CDSPrescriptionsCANTIDAD_DISPONIBLE.Value) then
     //   CDSPrescriptionsPROXIMOREFILL.Value := 'N/A';
    end;
  end;
  Except
    //
  End; }
end;

