function TDM.ServiceLevelCodeDefine(SpecialtyID: Integer):String;
Var
  InitialValue, ValueInt: Integer;
  SpecialtyID_Define: String;
begin
  With DM do
  begin
    InitialValue := StrToInt(Trim(CDSDoctoresServiceLevel.Value));
    while InitialValue > 0 do
    begin
      OpenSpecialty_ID(InitialValue);
      InitialValue := InitialValue - CDSSpecialty_IDBIT_VALUE.Value;
      if Trim(SpecialtyID_Define) = '' then
        SpecialtyID_Define := SpecialtyID_Define + ' ' + Trim(CDSSpecialty_IDSPECIALTY_ID.Value)
      else
        SpecialtyID_Define := SpecialtyID_Define + ', ' + Trim(CDSSpecialty_IDSPECIALTY_ID.Value);
    end;
  end;
  Result := Trim(SpecialtyID_Define);
end;

