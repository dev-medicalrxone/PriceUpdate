procedure TDM.CDSPrescriptions2CalcFields(DataSet: TDataSet);
Var
  TotalDispensado, TotalRecetado: Double;
  Dias: Integer;
  Mensage: String;
  Expirada: Boolean;
begin
{  Try
  if CDSPrescriptions2CANTIDADRECETADA.Value > 0 then
  begin
    TotalRecetado := CDSPrescriptions2CANTIDADRECETADA.Value * CDSPrescriptions2NUMEROREFILLSAUTORIZADOS.Value;
    TotalDispensado := TotalRecetado - CDSPrescriptions2CANTIDAD_DISPONIBLE.Value;
    CDSPrescriptions2NO_REFILL.Value := TotalDispensado / CDSPrescriptions2CANTIDADRECETADA.Value;
    if CDSPrescriptions2NO_REFILL.Value < 0 then CDSPrescriptions2NO_REFILL.Value := 0;

    Expirada := False;
    if Trim(CDSPrescriptionsCONTROLADO.Value) = 'RX' then
    begin
      if ((CDSPrescriptionsFECHARECETA.AsDateTime + CDSSetupRX_EXPIRATION_DAYS.Value) < Date) then
        Expirada := True;
    end
    else
    begin
       if ((CDSPrescriptionsFECHARECETA.AsDateTime + CDSSetupRX_CONTROLED_EXPIRATION_DAYS.Value) < Date) then
        Expirada := True;
    end;
    if Expirada = True then
      CDSPrescriptionsPROXIMOREFILL.Value := 'Rx Expirada'
    else
    begin
      if (CDSPrescriptions2NUMEROREFILLSAUTORIZADOS.Value > 0) and (CDSPrescriptions2FECHAULTIMOREFILL.AsString > '') then
      begin
        if (CDSPrescriptions2FECHAULTIMOREFILL.AsDateTime + CDSPrescriptions2DIASSUPLIDOS.Value < Date) and
        (((CDSPrescriptions2NUMEROREFILLSAUTORIZADOS.Value * CDSPrescriptions2CANTIDADRECETADA.Value) + CDSPrescriptions2CANTIDADRECETADA.Value) <> CDSPrescriptions2CANTIDAD_DISPONIBLE.Value) then
          Mensage := 'LISTA'
        else
          //Mensage := 'EN ' + IntToStr( DaysBetween(date, CDSPrescriptions2FECHAULTIMOREFILL.AsDateTime + CDSPrescriptions2DIASSUPLIDOS.Value)) + ' dias';
        CDSPrescriptions2PROXIMOREFILL.Value := Mensage;
      end
      else
