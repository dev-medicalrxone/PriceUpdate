procedure TDM.cdsPrescriptionFullCalcFields(DataSet: TDataSet);
Var
  TotalDispensado, TotalRecetado: Double;
  Expirada: Boolean;
begin
  case cdsPrescriptionFullCLAIM_STATUS.Value of
  0: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'N/A';
  1: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'BILLED';
  2: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'REJECTED';
  3: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'REVERSED';
  4: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'POST DATE';
  5: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'BILL LATER';
  //5: cdsPrescriptionFullCLAIM_STATUS_DEFINE.Value := 'CASH';
  end;

  if cdsPrescriptionFullRXORIGINCODE.Value = '1' then cdsPrescriptionFullRXORIGINCODE_DEFINE.Value := 'Written';
  if cdsPrescriptionFullRXORIGINCODE.Value = '2' then cdsPrescriptionFullRXORIGINCODE_DEFINE.Value := 'Telephone';
  if cdsPrescriptionFullRXORIGINCODE.Value = '3' then cdsPrescriptionFullRXORIGINCODE_DEFINE.Value := 'Electronic';
  if cdsPrescriptionFullRXORIGINCODE.Value = '4' then cdsPrescriptionFullRXORIGINCODE_DEFINE.Value := 'Facsimile';
  if cdsPrescriptionFullRXORIGINCODE.Value = '5' then cdsPrescriptionFullRXORIGINCODE_DEFINE.Value := 'Transfer';


  if cdsPrescriptionFullRX_STATUS.Value = 'N' then cdsPrescriptionFullSTATUS_CODE.Value := 'NEW';
  if cdsPrescriptionFullRX_STATUS.Value = 'P' then cdsPrescriptionFullSTATUS_CODE.Value := 'PARTIAL';
  if cdsPrescriptionFullRX_STATUS.Value = 'R' then cdsPrescriptionFullSTATUS_CODE.Value := 'REFILL';
  if cdsPrescriptionFullRX_STATUS.Value = 'C' then cdsPrescriptionFullSTATUS_CODE.Value := 'COPAY';
  TotalRecetado := cdsPrescriptionFullRX_QTY_PRESCRIBED.Value * cdsPrescriptionFullRX_REF_AUTHORIZED.Value;
  TotalDispensado := TotalRecetado - cdsPrescriptionFullRX_QTY_AVAILABLE.Value;
  cdsPrescriptionFullNO_REFILL.Value := TotalDispensado / cdsPrescriptionFullRX_QTY_PRESCRIBED.Value;
  if cdsPrescriptionFullNO_REFILL.Value < 0 then cdsPrescriptionFullNO_REFILL.Value := 0;
   Expirada := False;
    if Trim(cdsPrescriptionFullRX_CONTROL.Value) = 'RX' then
    begin
      if ((cdsPrescriptionFullRX_SERVICE_DATE.AsDateTime + CDSSetupRX_EXPIRATION_DAYS.Value) < Date) then
        Expirada := True;
    end
    else
    begin
       if ((cdsPrescriptionFullRX_SERVICE_DATE.AsDateTime + CDSSetupRX_CONTROLED_EXPIRATION_DAYS.Value) < Date) then
        Expirada := True;
    end;
    if Expirada = True then
      cdsPrescriptionFullPROXIMOREFILL.Value := 'Expired'
    else
    begin
      if (cdsPrescriptionFullRX_REF_AUTHORIZED.Value > 0) and (cdsPrescriptionFullRX_LAST_REFILL_DATE.AsString > '') then
      begin
        if (cdsPrescriptionFullRX_LAST_REFILL_DATE.AsDateTime + cdsPrescriptionFullDAYS_SUPPLY.Value < Date) and
        (((cdsPrescriptionFullRX_REF_AUTHORIZED.Value * cdsPrescriptionFullRX_QTY_PRESCRIBED.Value) + cdsPrescriptionFullRX_QTY_PRESCRIBED.Value) <> cdsPrescriptionFullRX_QTY_AVAILABLE.Value) then
          //Mensage := 'Ready'
        else
          //Mensage := 'In ' + IntToStr( DaysBetween(date, cdsPrescriptionFullRX_LAST_REFILL_DATE.AsDateTime + cdsPrescriptionFullDAYS_SUPPLY.Value)) + ' days';
        //cdsPrescriptionFullPROXIMOREFILL.Value := Mensage;
      end
      else
        cdsPrescriptionFullPROXIMOREFILL.Value := 'N/A';
      if cdsPrescriptionFullRX_QTY_AVAILABLE.Value = 0 then cdsPrescriptionFullPROXIMOREFILL.Value := 'N/A';
      //if (((cdsPrescriptionFullRX_REF_AUTHORIZED.Value * cdsPrescriptionFullRX_QTY_PRESCRIBED.Value) + cdsPrescriptionFullRX_QTY_PRESCRIBED.Value) = cdsPrescriptionFullRX_QTY_AVAILABLE.Value) then
      //  cdsPrescriptionFullPROXIMOREFILL.Value := 'N/A';
    end;

  {if (cdsPrescriptionFullRX_REF_AUTHORIZED.Value > 0) and (cdsPrescriptionFullRX_SERVICE_DATE.AsString > '') then
  begin
    if cdsPrescriptionFullRX_SERVICE_DATE.AsDateTime + cdsPrescriptionFullDAYS_SUPPLY.Value < Date then
      Mensage := 'READY'
    else
      Mensage := 'In ' + IntToStr( DaysBetween(date, cdsPrescriptionFullRX_SERVICE_DATE.AsDateTime + cdsPrescriptionFullDAYS_SUPPLY.Value)) + ' days ';
    cdsPrescriptionFullPROXIMOREFILL.Value := Mensage;
  end
  else
    cdsPrescriptionFullPROXIMOREFILL.Value := 'N/A';}

  cdsPrescriptionFullNombreCompleto.Value := Trim(cdsPrescriptionFullPAT_LASTNAME.Value) + ' ' + Trim(cdsPrescriptionFullPAT_MAIDENNAME.Value) + ' ' + cdsPrescriptionFullPAT_NAME.Value;
  cdsPrescriptionFullPresc_FullName.Value := Trim(cdsPrescriptionFullPRESC_LASTNAME.Value) + ' ' + Trim(cdsPrescriptionFullPRESC_MAIDENNAME.Value) + ' ' + cdsPrescriptionFullPRESC_NAME.Value;
  cdsPrescriptionFullTotal.Value := cdsPrescriptionFullPAT_PAY_AMOUNT.Value + cdsPrescriptionFullPLAN_PAY_AMOUNT.Value;
  if cdsPrescriptionFullPAT_SEX.Value = 1 Then cdsPrescriptionFullPAT_SEX_DEFINE.Value := 'Male';
  if cdsPrescriptionFullPAT_SEX.Value = 2 Then cdsPrescriptionFullPAT_SEX_DEFINE.Value := 'Female';
  //cdsPrescriptionFullPAT_Age.Value:=  Format('%d', [CommonRoutine.CalculateAge(DM.cdsPrescriptionFullPAT_DOB.AsDateTime, Date)]) + ' Years old';

  if cdsPrescriptionFullHealth_plan_abbreviation.Value <> 'CAS' then
  begin
    if cdsPrescriptionFullCLAIM_STATUS.Value = 1 then
      cdsPrescriptionFullEarning.Value := (cdsPrescriptionFullPLAN_PAY_AMOUNT.Value + cdsPrescriptionFullPAT_PAY_AMOUNT.Value + cdsPrescriptionFullRX_OTHER_AMOUNT_PAID.Value) - cdsPrescriptionFullSALES_COST.Value
    else
      cdsPrescriptionFullEarning.Value := 0;
  end
  else
    cdsPrescriptionFullEarning.Value := cdsPrescriptionFullCASH_RETAIL_PRICE.Value - cdsPrescriptionFullSALES_COST.Value;

  if cdsPrescriptionFullHealth_plan_abbreviation.Value <> 'CAS' then
    cdsPrescriptionFullPatPayAmount.Value := cdsPrescriptionFullPAT_PAY_AMOUNT.Value
  else
    cdsPrescriptionFullPatPayAmount.Value := cdsPrescriptionFullCASH_RETAIL_PRICE.Value;
