procedure TFrmMain.ListPackagePrices_(PackageID:Integer);
Var
  request: ListPackagePricesCurrentRequest;
  response: ListPackagePricesCurrent;
  alc: PackageIdentifierType;
  Serv: GSDDServiceSoap;
  Resp: String;
  Counter, I: Integer;
  SubTotalV: TXSDecimal;
  PackagePrice, UnitPrice: String;
  AWP_Alternative, AWP1, AWP2, AWP13: Double;

begin
  AWP_FINAL := 0;
  MAC := 0;
  AWP1 := 0;
  AWP2 := 0;
  AWP13 := 0;
  AWP_Alternative := 0;
  UnitPrice := '';
 {
      alc := PackageIdentifierType.Create;
      //alc.IdentifierType := PackageIdentifierEnum.PackageID;
      //alc.Identifier := IntToStr(PackageID);
      alc.IdentifierType := PackageIdentifierEnum.NDC11;
      alc.Identifier := Trim(DM.CDSInventarioNDC.value);
      request := ListPackagePricesCurrentRequest.Create;
      request.PackageIdentifier := alc;// IdentifierType.PackageID;
      try

        With ListPackagePricesRequest do
        begin
          Serv  :=  GetGSDDServiceSoap(False,'', HTTPRIO2);
          Response := Serv.ListPackagePricesCurrent(ListPackagePricesCurrentRequest(request));
          Counter := Length(Response.PriceData);
          for I := 0 to Counter - 1 do
          begin
            Try
                begin
                  if response.PriceData[I].PackagePrice <> nil then
                  begin
                    Try
                      if StrToFloat(response.PriceData[I].PackagePrice.NativeToXS) > AWP_Alternative then AWP_Alternative := StrToFloat(response.PriceData[I].PackagePrice.NativeToXS);
                    Except
                      AWP_Alternative := 0;
                    End;
                  end;
                  if response.PriceData[I].PriceTypeID = 1 then
                  begin
                    AWP1 := StrToFloat(response.PriceData[I].PackagePrice.NativeToXS);// StrToFloat(PackagePrice);
                  end;
                  if response.PriceData[I].PriceTypeID = 2 then
                  begin
                    MAC := StrToFloat(response.PriceData[I].PackagePrice.NativeToXS);
                  end;
                  if response.PriceData[I].PriceTypeID = 13 then
                  begin
                    AWP13 := StrToFloat(response.PriceData[I].PackagePrice.NativeToXS);
                  end;
                end;
                UnitPrice := '';
            Except
              //
            End;
          end;
        end;
      except
       //
      end;
      if AWP13 > 0  then
        AWP_FINAL := AWP13;
      if AWP1 > 0 then
        AWP_FINAL := AWP1;
      if AWP_FINAL = 0 Then AWP_FINAL := AWP_Alternative;
  Response.Destroy;
  }
